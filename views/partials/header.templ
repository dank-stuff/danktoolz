package partials

import "context"
import "codeberg.org/dankstuff/danktoolz/handlers/middlewares/pathname"
import "strings"

func activePage(ctx context.Context, matchPath string) string {
	pathname, ok := ctx.Value(pathname.PathNameKey).(string)
	if !ok {
		return ""
	}
	if pathname == "/" && pathname == matchPath {
		return "aria-current=page"
	}
	if strings.HasPrefix(pathname, matchPath) && matchPath != "/" {
		return "aria-current=page"
	}
	return ""
}

templ Header() {
	<header>
		<nav class="ac-nav ac-nav--sticky">
			<span class="ac-nav__mark">DankToolz</span>
			<div class="ac-nav__links">
				<a class="ac-nav__link" href="/" { activePage(ctx, "/") }>Index</a>
				<a class="ac-nav__link" href="/my-ip" { activePage(ctx, "/my-ip") }>My IP</a>
				<a class="ac-nav__link" href="/passwords" { activePage(ctx, "/passwords") }>Passwords</a>
				<a class="ac-nav__link" href="/clip" { activePage(ctx, "/clip") }>Clip</a>
				<a class="ac-nav__link" href="/urls" { activePage(ctx, "/urls") }>URL Shortner</a>
			</div>
			<span class="ac-nav__meta">
				<a class="doc-byline" href="https://dankstuff.net" target="_blank" rel="noopener">A DankStuff product</a>
			</span>
		</nav>
	</header>
}
